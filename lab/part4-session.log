kind: Service
metadata:
  name: gateway
  labels:
    app: gateway
    {{- include "lab.labels" . | nindent 4 }}
spec:
  selector:
    app: gateway
  ports:
    - name: http
      port: 80
      targetPort: {{ .Values.common.port }}
