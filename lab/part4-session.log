53-verify() {
54-  echo "==> verifying goal state in namespace $NS"
55-
56-  # 1. migration Job ran to completion
57-  if [ "$(kubectl -n "$NS" get job migrate -o jsonpath='{.status.succeeded}' 2>/dev/null)" = "1" ]; then
58-    ok "migrate Job completed"
59-  else
60-    bad "migrate Job has not completed (does it exist? did the chart even install cleanly?)"
61-  fi
62-
63-  # 2. every Deployment fully Ready
64:  for d in backend gateway worker reporter metrics; do
65-    want=$(kubectl -n "$NS" get deploy "$d" -o jsonpath='{.spec.replicas}' 2>/dev/null)
66-    have=$(kubectl -n "$NS" get deploy "$d" -o jsonpath='{.status.readyReplicas}' 2>/dev/null)
67-    if [ -n "$want" ] && [ "${have:-0}" = "$want" ]; then
68-      ok "deployment $d: $have/$want ready"
69-    else
70-      bad "deployment $d: ${have:-0}/${want:-?} ready"
71-    fi
72-  done
73-
74-  # 3. nothing is crash-looping
75-  loops=$(kubectl -n "$NS" get pods \
76-    -o jsonpath='{range .items[*]}{.metadata.name} {.status.containerStatuses[0].state.waiting.reason}{"\n"}{end}' 2>/dev/null \
--
79-    ok "no pods in CrashLoopBackOff"
80-  else
81-    bad "$loops pod(s) in CrashLoopBackOff"
82-  fi
83-
84:  # 4. the reporter ServiceAccount really may list pods
85-  if kubectl auth can-i list pods -n "$NS" \
86:      --as="system:serviceaccount:${NS}:reporter" >/dev/null 2>&1; then
87:    ok "ServiceAccount ${NS}/reporter can list pods"
88-  else
89:    bad "ServiceAccount ${NS}/reporter cannot list pods"
90-  fi
91-
92:  # 5. in-cluster behaviour: backend serves, gateway aggregates, reporter reports
93-  probe=$(incluster_probe)
94-  case "$probe" in *PROBE_BACKEND=ok*) ok "backend answers on http://backend:8080/healthz";;
95-                   *) bad "backend does not answer on http://backend:8080/healthz";; esac
96-  case "$probe" in *'"backend":"ok"'*) ok "gateway /status reports backend=ok";;
97-                   *) bad "gateway /status does not report backend=ok";; esac
98-  if printf '%s' "$probe" | grep -q 'PROBE_REPORTER_BODY=.*"pods":[1-9]'; then
99:    ok "reporter /report sees pods in the namespace"
100-  else
101:    bad "reporter /report does not return a pod count"
102-  fi
103-
104-  echo ""
105-  if [ "$FAIL" -eq 0 ]; then
106-    echo "${C_GREEN}ALL GREEN${C_OFF} — $PASS/$((PASS+FAIL)) checks passed. This part is done."
107-  else
108-    echo "${C_RED}$FAIL check(s) failing${C_OFF}, $PASS passing. Keep digging — every failure is a symptom."
109-  fi
110-  exit "$FAIL"
111-}
